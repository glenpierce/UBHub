doctype html
include mixins
html
    head
        title Intro to MapView - Create a 2D map - 4.15
        style.
            #viewDiv {
                padding: 0;
                margin: 0;
                height: 100vh;
                width: 100%;
            }

        link(rel="stylesheet" href="https://js.arcgis.com/4.15/esri/themes/light/main.css")
        script(type="module").
            import Map from "https://js.arcgis.com/4.15/esri/Map.js";
            import MapView from "https://js.arcgis.com/4.15/esri/views/MapView.js";

            const map = new Map({
                basemap: "dark-gray"
            });

            const view = new MapView({
                container: "viewDiv",
                map,
                zoom: 4,
                center: [15, 65] // longitude, latitude
            });

    body
        div(id="viewDiv")