doctype html
include mixins
html
  head
    link(rel='stylesheet', href='/stylesheets/style.css')
    style.
        .createUserContainer {
            max-width: 400px;
            text-align: center;
            padding-bottom: 20px;
            margin: auto;
            margin-top: 50px;
        }

        .entryLine {
            display: flex;
            align-items: center;
            width: 100%;
            padding-bottom: 5px;
        }

        .entryLineItem {
            margin: auto;
            width: 300px;
        }

        .entryLabel {
            display: inline-block;
            margin-top: 4px;
        }

        .entryInput {
            display: inline;
            float: right;
            border: solid;
            border-color: #4c90b6;
            border-radius: 5px;
            border-width: 1px;
            padding: 4px;
        }

        .createAccountSubmitButton {
            background-color: #4c90b6;
            border-radius:4px;
            border:none;
            font-weight: 700;
            padding:5px;
            color: white;
            cursor:pointer;
            margin:auto;
        }

body
  +dataManagementHeader

  script.
    function httpPostAsync(theUrl, callback) {
      const user = document.getElementById('username').value;
      const pass = document.getElementById('password').value;
      const userAddress = document.getElementById('userAddress').value + " organization:" + document.getElementById('organization').value;
      const data = {
        "username": user,
        "password": pass,
        "userAddress": userAddress
      }
      const xmlHttp = new XMLHttpRequest();
      xmlHttp.onreadystatechange = function () {
        if (xmlHttp.readyState == 4 && xmlHttp.status == 200)
          callback(xmlHttp.responseText);
      }
      xmlHttp.open("POST", theUrl, true); // true for asynchronous
      xmlHttp.setRequestHeader("Content-Type", "application/json; charset=utf-8");
      const dataAsJson = JSON.stringify(data);
      xmlHttp.send(dataAsJson);
    }
    function redirect(res) {
      window.location = res;
    }

  div.createUsercontainer
    div(style="display:inline;") Please create a new user below. Note that only pre-approved users are permitted to register during  our alpha development phase.

  form(id="emailForm" name="emailForm", method="post" onsubmit="submitForm()" style="display:flex; flex-direction:column; align-items:center; width:100%; padding-bottom:20px; margin-bottom:50px;")
    div.entryLine
      div.entryLineItem
        div.entryLabel Name
        input.entryInput(name="alias" type="text")
    div.entryLine
      div.entryLineItem
        div.entryLabel Title
        input.entryInput(name="title" type="text")
    div.entryLine
      div.entryLineItem
        div.entryLabel Institution
        input.entryInput(name="institution" type="text")
    div.entryLine
      div.entryLineItem
        div.entryLabel Mailing Address
        input.entryInput(name="userAddress" type="text")
    div.entryLine
      div.entryLineItem
        div.entryLabel Email
        input.entryInput(name="email" type="text")
    div.entryLine
      div.entryLineItem
        div.entryLabel WhatsApp
        input.entryInput(name="whatsAppNumber" type="text")
    div.entryLine
      div.entryLineItem
        div.entryLabel Password
        input.entryInput(name="password" type="password")
    div.entryLine
      div.entryLineItem
        div.entryLabel Verify Password
        input.entryInput(name="verifyPassword" type="password")
    input.createAccountSubmitButton(type="submit" value="Create User")

  script.
    function submitForm() {
      const formElements = document.getElementById("emailForm").elements;
      const postData = {};
      for (let i = 0; i < formElements.length; i++)
        if (formElements[i].type != "submit")
          postData[formElements[i].name] = formElements[i].value;
    }

  script.
    window.onload = function (ev) {
      const errorFromServer = !{errorFromServer};
      if (errorFromServer) {
        window.alert("There was a problem creating that user, the name is probably in use. Please try again.");
      }
    }