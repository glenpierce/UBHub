mixin header(displayLoginInfo)
  header
    div(class="nav-container")
      div(class="logo-container")
        img(src="/images/UBHub_logo_mainwebsite.svg")
      div
        div(class="login-container")
          button(class="menu-toggle")
          if(displayLoginInfo)
            if(username)
              div(style="padding:0px 100px 0px 50px; display:flex; justify-content:space-around; flex-grow:1;")
                div(style="padding:10px; cursor:pointer; color:#316b59; font-weight:700;" onclick="window.location='/account'") Account
            else
              div(style="padding:0px 100px 0px 50px; display:flex; justify-content:flex-end; flex-grow:1;")
                //div(style="padding:10px; cursor:pointer; color:#316b59; font-weight:700;" onclick="window.location='/createUser'") Sign up
            div(style="padding:4px 5px 2px 2px;")
              if(username)
                div(style="background-color:#d3e9d5; color:#316b59; padding:5px 30px 5px 30px; border-radius:20px; font-weight:700;") #{username}
              else
                div(style="background-color:#d3e9d5; color:#316b59; padding:5px 30px 5px 30px; border-radius:20px; font-weight:700; cursor:pointer;" onclick="window.location='/login'") Log in
          else
            div(style="color:#fab279; font-weight:700;") Signup / Log in
      nav(role='navigation' aria-label="main navigation")
        ul()
          li(onclick="window.location='/home'") Home
          li(onclick="window.location='/map'") Map
          if(username)
            div(style="padding:2px 5px 2px 2px;")
              div(style="background-color:#d3e9d5; cursor:pointer; color:#316b59; padding:5px 45px 5px 45px; border-radius:20px; font-weight:700;" onclick="window.location='/account/logout'") Logout
          else
            div
              div(style="padding:10px; cursor:pointer; color:#316b59; font-weight:700;" onclick="window.location='/createUser'") Sign up
  div(style="background:white; flex-grow:1;")

    div(style="width:100%;")

  div(style="width=100%; height: 170px;")

script.
  window.onload = function () {
    const navigationToggleButton = document.querySelector('.menu-toggle');
    const activeButton = document.querySelector('nav ul');

    if (!navigationToggleButton || !activeButton) {
      return;
    }
    navigationToggleButton.addEventListener('click', (clickEvent) => {
      if (clickEvent.target.nodeName == "BUTTON") {
        activeButton.classList.toggle('active-nav');
      }
    });

  };

script.

  function getCircularReplacer() {
    const seen = new WeakSet();
    return function (key, value) {
      if (typeof value === "object" && value !== null) {
        if (seen.has(value)) {
          return;
        }
        seen.add(value);
      }
      return value;
    };
  };

  function httpPost(theUrl, callback, data) {
    const xmlHttp = new XMLHttpRequest();
    xmlHttp.onreadystatechange = function () {
      if (xmlHttp.readyState == 4 && xmlHttp.status == 200)
        callback(xmlHttp.responseText);
    }
    xmlHttp.open("POST", theUrl, true); // true for asynchronous
    xmlHttp.setRequestHeader("Content-Type", "application/json; charset=utf-8");
    const dataAsJson = JSON.stringify(data, getCircularReplacer());
    console.log(dataAsJson);
    console.log(JSON.parse(dataAsJson));
    xmlHttp.send(dataAsJson);
  }

//- GDPR privacy notice plus a required, unticked consent checkbox.
//- purpose: 'mailingList' (signup) or 'account' (createUser).
mixin privacyNotice(purpose)
  div.privacyNotice(style="max-width:420px; margin:10px auto; padding:12px 16px; text-align:left; font-size:14px; line-height:1.4; border:1px solid #4c90b6; border-radius:5px;")
    strong How we use your information
    if purpose === 'account'
      p UBHub (Urban Biodiversity Hub) stores the details you enter here (name, title, institution, mailing address, email, WhatsApp number) and a securely hashed copy of your password. We use them to run your account and to contact you about UBHub. We do not sell your information or share it for marketing.
    else
      p UBHub (Urban Biodiversity Hub) stores the details you enter here (name, email, and optionally your institution, title and region). We use them only to send you UBHub news and updates. We do not sell your information or share it for marketing.
    p Our legal basis is your consent. Your data is stored on servers run by Amazon Web Services, and our emails are sent through our email provider, Brevo. We keep your information until you withdraw consent or ask us to delete it.
    p
      | You can ask to see, correct or delete your information, or withdraw your consent, at any time.
      |  Once logged in, you can request removal from your account; we stop emailing you and delete your data.
    label(style="display:flex; gap:8px; align-items:flex-start; cursor:pointer;")
      input(type='checkbox' name='privacyConsent' value='yes' required style="margin-top:3px;")
      span I agree to UBHub storing and using my information as described above.

//- "First name" / "Last name" inputs that public/javascripts/nameFields.js joins into
//- the hidden `alias` input on submit (the server only stores one name). Put
//- `data-combine-name-fields` on the enclosing form. Both parts are required in
//- the browser (product requirement); the server still only sees `alias`. Each
//- part is capped at 127 characters so the combined name fits the 255-character
//- alias column.
mixin splitNameFields(values)
  - const nameValues = values || {}
  div.entryLine
    div.entryLineItem
      label.entryLabel(for='firstName') First name *
      input.entryInput#firstName(name='firstName' data-name-part='first' type='text' required maxlength='127' autocomplete='given-name' value=nameValues.firstName)
  div.entryLine
    div.entryLineItem
      label.entryLabel(for='lastName') Last name *
      input.entryInput#lastName(name='lastName' data-name-part='last' type='text' required maxlength='127' autocomplete='family-name' value=nameValues.lastName)
  input(type='hidden' name='alias')
  script(type='module' src='/javascripts/nameFields.js')
