doctype html
include mixins
html
  head
    link(rel='stylesheet', href='/stylesheets/style.css')
    link(rel='stylesheet', href='/stylesheets/index.css')
    style.
      .data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      .data-table th, .data-table td {
        border: 1px solid #ddd;
        padding: 8px;
      }
      .data-table th {
        position: sticky;
        top: 0;
        background-color: #f2f2f2;
        cursor: pointer;
      }
      .data-table tr:nth-child(even) {
        background-color: #f9f9f9;
      }
      .data-table tr:hover {
        background-color: #e9e9e9;
      }
      .table-container {
        max-height: 70vh;
        overflow-y: auto;
      }

  body
    +header(true)
    div(style="padding-top:40px;")

    div.container
      h1 Database Admin View

      div.row
        div.col-md-12
          select#tableSelector.form-control
            option(value="") Select a table...
            each table in tables
              option(value=table)= table

          div.row.mt-3
              div.col-md-12
                  h3 Create pending change
                  form#pendingForm
                      .form-group
                          label(for="pendingTable") Table
                          select#pendingTable.form-control
                              option(value="") Select table...
                              each t in tables
                                  option(value=t)= t
                      .form-group
                          label(for="operationSelect") Operation
                          select#operationSelect.form-control
                              option(value="insert") insert
                              option(value="update") update
                              option(value="delete") delete
                      .form-group
                          label(for="rowKeyInput") Row key JSON (e.g. {"id":123})
                          textarea#rowKeyInput.form-control(rows="3")
                      .form-group
                          label(for="dataInput") Data JSON (object with columns)
                          textarea#dataInput.form-control(rows="5")
                      button#submitPending.btn.btn-primary(type="button") Submit pending change


    script.
        document.addEventListener('DOMContentLoaded', function () {
            const pendingFormBtn = document.getElementById('submitPending');
            const pendingTable = document.getElementById('pendingTable');
            const operationSelect = document.getElementById('operationSelect');
            const rowKeyInput = document.getElementById('rowKeyInput');
            const dataInput = document.getElementById('dataInput');

            pendingFormBtn.addEventListener('click', async function () {
                const tableName = pendingTable.value || document.getElementById('tableSelector').value;
                if (!tableName) {
                    alert('Select a table');
                    return;
                }

                let rowKeyObj = {};
                let dataObj = {};
                try {
                    if (rowKeyInput.value) rowKeyObj = JSON.parse(rowKeyInput.value);
                } catch (e) {
                    alert('Invalid JSON in Row key');
                    return;
                }
                try {
                    if (dataInput.value) dataObj = JSON.parse(dataInput.value);
                } catch (e) {
                    alert('Invalid JSON in Data');
                    return;
                }

                const payload = {
                    tableName,
                    operation: operationSelect.value,
                    rowKey: rowKeyObj,
                    data: dataObj
                };

                try {
                    const resp = await fetch('/api/admin/pending-change', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify(payload)
                    });
                    if (!resp.ok) {
                        const err = await resp.json().catch(() => ({error: resp.statusText}));
                        alert('Error: ' + (err.error || resp.statusText));
                        return;
                    }
                    alert('Pending change created');
                } catch (err) {
                    console.error(err);
                    alert('Network error');
                }
            });
        });
          document.addEventListener('DOMContentLoaded', function() {
            const tableSelector = document.getElementById('tableSelector');

            tableSelector.addEventListener('change', function() {
              if (this.value) {
                fetchTableData(this.value);
              } else {
                clearTable();
              }
            });

            function fetchTableData(tableName) {
              fetch(`/api/admin/table-data/${tableName}`)
                .then(response => {
                  if (!response.ok) {
                    throw new Error('Not authorized or table not found');
                  }
                  return response.json();
                })
                .then(data => {
                  populateTable(data);
                })
                .catch(error => {
                  console.error('Error fetching data:', error);
                  alert('Error: ' + error.message);
                });
            }

            function populateTable(data) {
              if (!data || !data.length) {
                clearTable();
                return;
              }

              const headerRow = document.getElementById('headerRow');
              const tableBody = document.getElementById('tableBody');

              headerRow.innerHTML = '';
              tableBody.innerHTML = '';

              const columns = Object.keys(data[0]);
              columns.forEach(column => {
                headerRow.innerHTML += `<th data-column="${column}">${column}</th>`;
              });

              data.forEach(row => {
                let tr = document.createElement('tr');
                columns.forEach(column => {
                  let td = document.createElement('td');
                  td.textContent = row[column] !== null ? row[column] : '';
                  tr.appendChild(td);
                });
                tableBody.appendChild(tr);
              });
            }

            function clearTable() {
              document.getElementById('headerRow').innerHTML = '';
              document.getElementById('tableBody').innerHTML = '';
            }
        });

    +footer()