doctype html
html
  head
    script.
      function onTableSelected(selectedTable) {
        if (selectedTable) {
          fetchTableData(selectedTable);
        } else {
          clearTable();
        }
      }

      function fetchTableData(tableName) {
        fetch(`/api/admin/table-data/${tableName}`)
          .then(response => {
            if (!response.ok) {
              throw new Error('Not authorized or table not found');
            }
            return response.json();
          })
          .then(data => {
            populateTable(data);
          })
          .catch(error => {
            console.error('Error fetching data:', error);
            alert('Error: ' + error.message);
          });
      }

      function populateTable(data) {
        if (!data || !data.length) {
          clearTable();
          return;
        }

        const headerRow = document.getElementById('headerRow');
        const tableBody = document.getElementById('tableBody');

        headerRow.innerHTML = '';
        tableBody.innerHTML = '';

        const columns = Object.keys(data[0]);
        columns.forEach(column => {
          headerRow.innerHTML += `<th data-column="${column}">${column}</th>`;
        });

        data.forEach(row => {
          let tr = document.createElement('tr');
          columns.forEach(column => {
            let td = document.createElement('td');
            td.textContent = row[column] !== null ? row[column] : '';
            tr.appendChild(td);
          });
          tableBody.appendChild(tr);
        });
      }

      function clearTable() {
        document.getElementById('headerRow').innerHTML = '';
        document.getElementById('tableBody').innerHTML = '';
      }
    link(rel='stylesheet', href='/stylesheets/style.css')
    link(rel='stylesheet', href='/stylesheets/index.css')
    style.
      .layout {
        display: flex;
        gap: 20px;
        align-items: flex-start;
      }
      .left-col {
        flex: 0 0 180px; /* fixed sidebar width */
        border-right: 1px solid #e5e5e5;
        background: #fff;
        height: 100vh;
        position: sticky;
        top: 60px;
        overflow-y: auto;
      }
      .main-col {
        flex: 1; /* take remaining space */
        min-width: 0; /* prevents overflow with long content */
      }

      .clickable {
        cursor: pointer;
        padding: 10px;
      }
      .clickable:hover {
        background-color: #f3f7fb;
        transform: translateY(-1px);
      }
      .nav-icon {
        width: 18px;
        height: 18px;
        margin-right: 8px;
        vertical-align: middle;
      }

      .data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      .data-table th, .data-table td {
        border: 1px solid #ddd;
        padding: 8px;
      }
      .data-table th {
        position: sticky;
        top: 0;
        background-color: #f2f2f2;
        cursor: pointer;
      }
      .data-table tr:nth-child(even) {
        background-color: #f9f9f9;
      }
      .data-table tr:hover {
        background-color: #e9e9e9;
      }
      .table-container {
        max-height: 70vh;
        overflow-y: auto;
      }

  body
    //+header(true)
  div(style="padding-top:40px;")

  div.layout
    aside.left-col
      nav
        div
          div.clickable(onclick="onTableSelected('mapButtons')")
            img.nav-icon(src='/icons/programIcon.svg', alt='Program icon')
            | Programs
          div.clickable(onclick="onTableSelected('locations')" )
            img.nav-icon(src='/icons/institutionIcon.svg', alt='Institutions icon')
            | Institutions
          div.clickable(onclick="onTableSelected('participation')")
            img.nav-icon(src='/icons/participationIcon.svg', alt='Participations icon')
            | Participations
          div.clickable(onclick="onTableSelected('row_versions')")
            img.nav-icon(src='/icons/submissionIcon.svg', alt='Submissions icon')
            | Submissions


    main.main-col
      div.container
        h1 Tables

        div
          div
            div.table-container
              table.data-table#dataTable
                thead
                  tr#headerRow
                tbody#tableBody
