doctype html
include mixins
html
  head
    link(rel='stylesheet', href='/stylesheets/style.css')

  body
    block content

    script.
      window.onload = function () {
        const emailField = document.getElementById('email');
        if (emailField) { emailField.focus(); }

        try {
          const params = new URLSearchParams(window.location.search);
          if (params.get('created') === '1') {
            window.alert('Account created successfully. You may now log in.');
            params.delete('created');
            const newSearch = params.toString();
            const newUrl = window.location.pathname + (newSearch ? ('?' + newSearch) : '');
            window.history.replaceState({}, document.title, newUrl);
          }
        } catch (showAccountCreatedPopupError) {
          console.warn('Could not show account-created popup:', showAccountCreatedPopupError);
        }
      }


    +dataManagementHeader

    form(method='post', action='/users', id='loginForm', autocomplete='on', style='display:flex; flex-direction:column; align-items:center; width:100%; padding-bottom:20px;')
      div(style='padding-bottom:20px;')
        div(style='display:inline;') Welcome! Please log in below, or return to our&nbsp;
        div(style="display:inline; color:#4490ba; cursor:pointer;" onclick="window.location='/home'")
          u home page

      div(style='display:flex; align-items:center; width:100%; padding-bottom:5px;')
        div(style='margin:auto; width:300px;')
          label(for='email' style='display:inline-block; margin-top:4px;') Email
          input#email(name='email' type='text' required autocomplete='username' autocapitalize='off' spellcheck='false' style='display:inline; float:right; border:solid; border-color:#4490ba; border-radius:5px; border-width:1px; padding:4px;')

      div(style='display:flex; align-items:center; width:100%; padding-bottom:5px;')
        div(style='margin:auto; width:300px;')
          label(for='password' style='display:inline-block; margin-top:4px;') Password
          input#password(name='password' type='password' required autocomplete='current-password' autocapitalize='off' spellcheck='false' style='display:inline; float:right; border:solid; border-color:#4490ba; border-radius:5px; border-width:1px; padding:4px;')

      button(type='submit' style='background-color:#4490ba; border-radius:5px; border:none; padding:5px; color: white; cursor:pointer; margin:auto;') Login
