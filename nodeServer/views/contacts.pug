extends layout

block content
  div.layout
    main.main-col
      div.container
        .profileEditEntryFieldContainer
          h1#tableTitle Contacts
          if user
            span#userAlias.userAlias Hello, #{user}

      // table + form area
      div.largerPadding
        div
          div.table-and-map
            div.table-container
              table.data-table#contactsTable
                thead
                  tr
                    th Name
                    th Email
                    th Phone
                    th Title
                    th Organization
                    th Region
                    th Level
                    th Working Group
                    th Role
                    th Actions
                tbody

            // form sits below the table, but uses the same styled form containers
            div.form-container
              form#contactForm
                input(type='hidden' id='contactEmail')
                .profileEditEntryFieldContainer
                  label(for='alias') Name
                  input.dataManagementInput(type='text' id='alias' name='alias')
                .profileEditEntryFieldContainer
                  label(for='email') Email
                  input.dataManagementInput(type='email' id='email' name='email')
                .profileEditEntryFieldContainer
                  label(for='phone') Phone
                  input.dataManagementInput(type='text' id='phone' name='phone')
                .profileEditEntryFieldContainer
                  label(for='title') Title
                  input.dataManagementInput(type='text' id='title' name='title')
                .profileEditEntryFieldContainer
                  label(for='institution') Organization
                  input.dataManagementInput(type='text' id='institution' name='institution')
                .profileEditEntryFieldContainer
                  label(for='region') Region
                  // Region is a multi-select so a user can belong to multiple regions
                  select.dataManagementInput(id='region' name='region' multiple size='6')
                    option(value='NA') NA: Canada, US, and Israel
                    option(value='LA') LA: Latin America
                    option(value='CAR') CAR: Caribbean and Pacific Islands
                    option(value='MECNA') MECNA: Middle East, Central Asia, and Northern Asia
                    option(value='AF') AF: Africa
                    option(value='ESA') ESA: East and South East Asia
                    option(value='SA') SA: Southern Asia
                    option(value='EU') EU: Europe
                    option(value='OC') OC: Oceania
                .profileEditEntryFieldContainer
                  label(for='level') Level
                  input.dataManagementInput(type='text' id='level' name='level')
                .profileEditEntryFieldContainer
                  label(for='workingGroup') Working Group
                  input.dataManagementInput(type='text' id='workingGroup' name='workingGroup')
                .modal-actions
                  button.primary(type='button' id='saveButton') Save
                  button.secondary(type='button' id='addNewButton') Add New

  script.
    (function() {
      // Map numeric privilege levels to human-readable role names
      const PRIVILEGE_LEVEL_LABELS = { 0: 'Contact', 1: 'User', 2: 'Contributor', 3: 'Approver', 4: 'Executive' };

      function clearForm() {
        document.getElementById('contactEmail').value = '';
        document.getElementById('alias').value = '';
        document.getElementById('email').value = '';
        document.getElementById('phone').value = '';
        document.getElementById('title').value = '';
        document.getElementById('institution').value = '';
        Array.from(document.getElementById('region').options).forEach(function(opt) { opt.selected = false; });
        document.getElementById('level').value = '';
        document.getElementById('workingGroup').value = '';
        document.getElementById('email').disabled = false;
      }

      async function fetchList() {
        const res = await fetch('/contacts/list');
        if (!res.ok) return;
        const rows = await res.json();
        const tbody = document.querySelector('#contactsTable tbody');
        tbody.innerHTML = '';
        rows.forEach(function(row) {
          const tr = document.createElement('tr');
          const roleLabel = PRIVILEGE_LEVEL_LABELS[row.privileges] || String(row.privileges);
          // region may be stored as a comma-separated string of codes
          tr.innerHTML = `<td>${row.alias || ''}</td><td>${row.email || ''}</td><td>${row.phone || ''}</td><td>${row.title || ''}</td><td>${row.institution || ''}</td><td>${row.region || ''}</td><td>${row.level || ''}</td><td>${row.workingGroup || ''}</td><td>${roleLabel}</td>`;
          const actionsTd = document.createElement('td');
          const editButton = document.createElement('button');
          editButton.textContent = 'Edit';
          editButton.addEventListener('click', function() {
            document.getElementById('contactEmail').value = row.email;
            document.getElementById('alias').value = row.alias || '';
            document.getElementById('email').value = row.email || '';
            document.getElementById('phone').value = row.phone || '';
            document.getElementById('title').value = row.title || '';
            document.getElementById('institution').value = row.institution || '';
            // Set selected options for multi-select region
            const regionSelect = document.getElementById('region');
            const regionValue = row.region || '';
            const selectedCodes = regionValue.split(',').map(function(s) { return String(s).trim(); }).filter(Boolean);
            Array.from(regionSelect.options).forEach(function(opt) {
              opt.selected = selectedCodes.includes(opt.value);
            });
            document.getElementById('level').value = row.level || '';
            document.getElementById('workingGroup').value = row.workingGroup || '';
            // Disable email field when editing since email is the primary key
            document.getElementById('email').disabled = true;
            // scroll form into view on small screens
            document.getElementById('contactForm').scrollIntoView({behavior: 'smooth', block: 'center'});
          });
          const deleteButton = document.createElement('button');
          deleteButton.textContent = 'Delete';
          deleteButton.addEventListener('click', async function() {
            if (!confirm('Delete this contact?')) return;
            const resp = await fetch('/contacts/delete/' + encodeURIComponent(row.email), {method: 'POST'});
            if (resp.ok) fetchList(); else alert('Delete failed');
          });
          actionsTd.appendChild(editButton);
          actionsTd.appendChild(document.createTextNode(' '));
          actionsTd.appendChild(deleteButton);
          tr.appendChild(actionsTd);
          tbody.appendChild(tr);
        });
      }

      document.getElementById('saveButton').addEventListener('click', async function() {
        const originalEmail = document.getElementById('contactEmail').value;
        const payload = {
          alias: document.getElementById('alias').value,
          email: document.getElementById('email').value,
          phone: document.getElementById('phone').value,
          title: document.getElementById('title').value,
          institution: document.getElementById('institution').value,
          // collect selected region codes as an array
          region: Array.from(document.getElementById('region').selectedOptions).map(function(o){ return o.value; }),
          level: document.getElementById('level').value,
          workingGroup: document.getElementById('workingGroup').value,
        };
        let url = '/contacts/add';
        if (originalEmail) url = '/contacts/edit/' + encodeURIComponent(originalEmail);
        const resp = await fetch(url, {method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload)});
        if (resp.ok) {
          clearForm();
          fetchList();
        } else {
          const err = await resp.json().catch(() => ({}));
          alert('Save failed: ' + (err.error || resp.statusText));
        }
      });

      document.getElementById('addNewButton').addEventListener('click', function() {
        clearForm();
      });

      // Initial load
      fetchList().catch(function(e){console.error(e)});
    })();
