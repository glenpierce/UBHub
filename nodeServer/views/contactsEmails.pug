extends layout

block content
  div.layout
    main.main-col
      div.container
        .profileEditEntryFieldContainer
          h1 Contacts - Email recipients
          if user
            span#userAlias.userAlias Hello, #{user}

      div.largerPadding
        div
          .form-container
            form#emailsForm
              .profileEditEntryFieldContainer
                label(for='regions') Select Regions
                select.dataManagementInput(id='regions' name='regions' multiple size='6')
                  option(value='NA') NA: Canada, US, and Israel
                  option(value='LA') LA: Latin America
                  option(value='CAR') CAR: Caribean and Pacific Islands
                  option(value='MECNA') MECNA: Middle East, Central Asia, and Northern Asia
                  option(value='AF') AF: Africa
                  option(value='ESA') ESA: East and South East Asia
                  option(value='SA') SA: Southern Asia
                  option(value='EU') EU: Europe
                  option(value='OC') OC: Oceania
              .modal-actions
                button.primary(type='button' id='generateButton') Generate List
                button.secondary(type='button' id='clearButton') Clear

          .result-container
            label(for='emailsText') Copy-paste recipient list
            textarea#emailsText.rows(6).dataManagementInput
            .smallText
              p Count: span#emailsCount 0
              p
                button(type='button' id='copyButton') Copy to clipboard

  script.
    (function(){
      document.getElementById('generateButton').addEventListener('click', async function(){
        const selected = Array.from(document.getElementById('regions').selectedOptions).map(function(o){ return o.value; });
        if (!selected.length) { alert('Select at least one region'); return; }
        const params = new URLSearchParams();
        params.set('regions', selected.join(','));
        const res = await fetch('/contacts/emails?' + params.toString());
        if (!res.ok) { const err = await res.json().catch(()=>({})); alert('Failed: ' + (err.error || res.statusText)); return; }
        const data = await res.json();
        document.getElementById('emailsText').value = data.copyText || (data.emails || []).join(', ');
        document.getElementById('emailsCount').textContent = String(data.count || (data.emails || []).length || 0);
      });

      document.getElementById('clearButton').addEventListener('click', function(){
        Array.from(document.getElementById('regions').options).forEach(function(o){ o.selected = false; });
        document.getElementById('emailsText').value = '';
        document.getElementById('emailsCount').textContent = '0';
      });

      document.getElementById('copyButton').addEventListener('click', function(){
        const txt = document.getElementById('emailsText');
        txt.select();
        try { document.execCommand('copy'); alert('Copied to clipboard'); } catch(e){ alert('Copy failed: ' + e.message); }
      });
    })();

