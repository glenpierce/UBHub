doctype html
include mixins
html
  head
    script.
      window.dataManagementConfigFromServer = !{dataManagementConfig};

    script(type="module" src="/javascripts/data-management/dataManagementInitialization.js")

    link(rel='stylesheet', href='/stylesheets/style.css')

  body
  +dataManagementHeader

  div.layout
    aside.left-col
      nav
        div#navigationMenu

    main.main-col
      div.container
        div.profileEditEntryFieldContainer
          h1#tableTitle
          if user
            span#userAlias.userAlias Hello, #{user}
          button.primary#addButton(onclick="addNewEntry()" style="display:none") Add New Entry
          button.secondary#emailListButton(style="display:none") Email List

      div.globalSearchContainer
        input#globalSearch.dataManagementInput(type="text", placeholder="Global search...")
      div.row-controls
        select#columnPicker.dataManagementInput.flex-1
        input#columnFilter.dataManagementInput.flex-2(type="text", placeholder="Column value filter...")
        button#clearFilters.clearFilters(type="button") Clear Filters

      div
        div
          div.table-and-map
            div.table-container
              table.data-table#dataTable
                thead
                  tr#headerRow
                tbody#tableBody

            // Inline map container (hidden by default). The map iframe will be shown here
            div.map-container.hidden#mapContainer
              .map-header
                h2 Map
              .map-body
                iframe#mapIframe(src="about:blank" sandbox="allow-same-origin allow-scripts allow-forms allow-popups" style="width:100%;height:70vh;")

// Modal overlay for adding a new entry
.modal-overlay#modalOverlay.hidden
  .modal(id="modalContainer")
    h2.modal-title#modalTitle
    form#modalForm
      #modalFields
      .modal-actions
        button(type="button", onclick="closeModal()") Cancel
        button(type="submit") Submit

// Modal overlay specifically for review actions (Approve / Reject)
.modal-overlay#modalOverlayReview.hidden
  .modal(id="modalContainerReview")
    h2.modal-title#modalTitleReview
    // We use a separate form container for review fields, but the review actions are handled
    // by explicit buttons (Approve / Reject) rather than a form submit so the decision is clear.
    form#modalFormReview
      #modalFieldsReview
      .modal-actions
        // Buttons will be wired programmatically by the ModalManager to ensure handlers are
        // attached and that only one overlay is visible at a time.
        // Provide placeholders for accessibility and graceful fallback.
        button(type="button", id="closeReviewButton", onclick="closeModal()") Cancel
        button(type="button", id="approveReviewButton") Approve
        button(type="button", id="rejectReviewButton") Reject

.modal-overlay#modalOverlayMyProfile.hidden
  .modal(id="modalContainerMyProfile")
    // user info and editable profile form
    form#modalFormMyProfile
      .modal-section
        div.userNameContainer #{username}
        div.profileEditEntryFieldContainer
          label(for="alias") Account name
          button.help-icon(type="button" data-help-key="profile.alias" aria-label="Help for Account name") ?
          input(type="text" id="alias" name="alias" class="dataManagementInput")
        div.profileEditEntryFieldContainer
          label(for="userAddress") Address
          button.help-icon(type="button" data-help-key="profile.userAddress" aria-label="Help for Address") ?
          input(type="text" id="userAddress" name="userAddress" class="dataManagementInput")
        div.profileEditEntryFieldContainer
          label(for="title") Title
          button.help-icon(type="button" data-help-key="profile.title" aria-label="Help for Title") ?
          input(type="text" id="title" name="title" class="dataManagementInput")
        div.profileEditEntryFieldContainer
          label(for="institution") Institution
          button.help-icon(type="button" data-help-key="profile.institution" aria-label="Help for Institution") ?
          input(type="text" id="institution" name="institution" class="dataManagementInput")
        div.profileEditEntryFieldContainer
          label(for="whatsAppNumber") WhatsApp number
          button.help-icon(type="button" data-help-key="profile.whatsAppNumber" aria-label="Help for WhatsApp number") ?
          input(type="text" id="whatsAppNumber" name="whatsAppNumber" class="dataManagementInput")
        div.profileEditEntryFieldContainer
          label(for="primaryContact") Primary contact
          button.help-icon(type="button" data-help-key="profile.primaryContact" aria-label="Help for Primary contact") ?
          input(type="text" id="primaryContact" name="primaryContact" class="dataManagementInput")
      .modal-actions
        button(type="button", onclick="closeMyProfileModalFunction()") Close
        button(type="submit") Save Changes

    // Keep the password change controls outside the profile form for compatibility with existing handlers
    div.largeMarginBottom
      div.profileEditEntryFieldContainer
        b Change password
      div Current password
      input(type="password" id="oldPassword" class="dataManagementInput profileEditEntryFieldContainer")
      //div.forgot-password-link(onclick="showForgotPasswordPopup()") Forgot password
      div New password
      input(type="password" id="newPassword" class="dataManagementInput profileEditEntryFieldContainer")
      div Confirm new password
      input(type="password" id="confirmNewPassword" class="dataManagementInput profileEditEntryFieldContainer")
      div.modal-actions
        button.button-margin(onclick="changePassword()") Change password

// Modal overlay for generating filtered email lists from the Users table
.modal-overlay#modalOverlayEmailList.hidden
  .modal(id="modalContainerEmailList")
    h2.modal-title Email List
    .profileEditEntryFieldContainer
      label(for='emailListRegions') Region
      select#emailListRegions.dataManagementInput(multiple size='9')
        option(value='NA') NA: Canada, US, and Israel
        option(value='LA') LA: Latin America
        option(value='CAR') CAR: Caribbean and Pacific Islands
        option(value='MECNA') MECNA: Middle East, Central Asia, and Northern Asia
        option(value='AF') AF: Africa
        option(value='ESA') ESA: East and South East Asia
        option(value='SA') SA: Southern Asia
        option(value='EU') EU: Europe
        option(value='OC') OC: Oceania
    .profileEditEntryFieldContainer
      label(for='emailListInstitution') Institution contains
      input#emailListInstitution.dataManagementInput(type='text' placeholder='e.g. Zoo')
    .profileEditEntryFieldContainer
      label(for='emailListTitle') Title contains
      input#emailListTitle.dataManagementInput(type='text' placeholder='e.g. Director')
    .profileEditEntryFieldContainer
      label(for='emailListWorkingGroup') Working Group contains
      input#emailListWorkingGroup.dataManagementInput(type='text' placeholder='e.g. Education')
    .profileEditEntryFieldContainer
      label(for='emailListLevel') Level (exact match)
      input#emailListLevel.dataManagementInput(type='text' placeholder='e.g. Senior')
    .profileEditEntryFieldContainer
      label(for='emailListPrivileges') Role (exact match)
      select#emailListPrivileges.dataManagementInput
        option(value='') Any role
        option(value='0') 0: Contact
        option(value='1') 1: Contributor
        option(value='2') 2: Approver
        option(value='3') 3: Admin
        option(value='4') 4: Executive
    .profileEditEntryFieldContainer
      label(for='emailListSubject') Email subject
      input#emailListSubject.dataManagementInput(type='text' placeholder='Subject line')
    .profileEditEntryFieldContainer
      label(for='emailListHtmlBody') Email content
      .richTextEditorContainer
        .richTextToolbar#emailListRichTextToolbar(role='toolbar' aria-label='Text formatting')
          button.richTextButton(type='button' data-rt-command='bold' title='Bold' aria-label='Bold')
            b B
          button.richTextButton(type='button' data-rt-command='italic' title='Italic' aria-label='Italic')
            i I
          button.richTextButton(type='button' data-rt-command='underline' title='Underline' aria-label='Underline')
            u U
          button.richTextButton(type='button' data-rt-command='insertUnorderedList' title='Bullet list' aria-label='Bullet list') •&nbsp;List
          button.richTextButton(type='button' data-rt-command='insertOrderedList' title='Numbered list' aria-label='Numbered list') 1.&nbsp;List
          button.richTextButton(type='button' data-rt-command='createLink' title='Insert link' aria-label='Insert link') Link
          button.richTextButton(type='button' data-rt-command='removeFormat' title='Clear formatting' aria-label='Clear formatting') Clear
        div#emailListHtmlBody.dataManagementInput.richTextEditor(contenteditable='true' role='textbox' aria-multiline='true' aria-label='Email content' data-placeholder='Write the email content...')
    .smallText
      span Recipient count: &nbsp;
      span#emailListCount 0
    .modal-actions
      button(type='button' id='closeEmailListButton') Close
      button.secondary(type='button' id='generateEmailListButton') Preview Recipient Count
      button.primary(type='button' id='requestEmailScheduleButton') Request Email be Scheduled

