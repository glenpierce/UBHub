doctype html
html
  head
    script.
      const dataManagementConfigFromServer = !{dataManagementConfig};

      const tables = dataManagementConfigFromServer.tablesForUser || {};
      const navMenu = dataManagementConfigFromServer.navMenu || [];
      const currentUser = dataManagementConfigFromServer.user || null;

      let modalMode = null; // 'add', 'edit, or 'review'
      let currentRow = null;

      const renderers = {
        nameRenderer: renderNameFunction,
        privilegeRenderer: renderPrivilegeFunction,
        statusRenderer: statusRendererFunction,
        submissionStatusRenderer: submissionStatusRendererFunction,
        assignRenderer: assignRendererFunction,
        lastActiveRenderer: lastActiveRendererFunction
      }

      const navMenuOnClickHandlers = {
        openMyProfileModal: openMyProfileModalFunction
      };

      function openMyProfileModalFunction() {
        document.getElementById('modalOverlayMyProfile').style.display = 'flex';
      }

      function closeMyProfileModalFunction() {
        document.getElementById('modalOverlayMyProfile').style.display = 'none';
      }

      const clickHandlers = {
        openReviewModal: function(row) {
          buildModalForReview(row);
          openModal(false);
        },
        openEditUserModal: function(row) {
          buildModalForTable('users');
          const form = document.getElementById('modalForm');
          form.querySelectorAll('[data-col-name]').forEach(inputValue => {
            if (row.hasOwnProperty(inputValue.dataset.colName)) {
              inputValue.value = row[inputValue.dataset.colName];
            } else {
              inputValue.value = '';
            }
          });
          openModal(false);
        },
        openEditProgramModal: openEditModalFunction('mapButtons'),
        openEditLocationModal: openEditModalFunction('locations'),
        openEditDocumentModal: openEditModalFunction('documents'),
        openEditProgramParticipationModal: openEditModalFunction('participation')
      };

      function openEditModalFunction(tableName) {
        return function(row) {
          buildModalForTable(tableName);
          modalMode = 'edit';
          currentRow = row;
          const form = document.getElementById('modalForm');
          // populate hidden/normal inputs that have data-col-name set
          form.querySelectorAll('[data-col-name]').forEach(inputElement => {
            const inputElementId = inputElement.getAttribute("id");
            // for hidden inputs (lookupColumn), the id equals the column name (e.g. inst_id) so set value from row
            if (row.hasOwnProperty(inputElementId)) {
              inputElement.value = row[inputElementId];
            } else {
              inputElement.value = '';
            }
          });

          // populate any search inputs for cross-reference columns (e.g. search_inst_id)
          const columns = tables[tableName].columns || [];
          columns.forEach(col => {
            if (col.crossReferenceTable && col.lookupColumn && col.joinedColumn) {
              const searchInput = document.getElementById(`search_${col.lookupColumn}`);
              const hiddenInput = document.getElementById(col.lookupColumn);
              if (hiddenInput && hiddenInput.value) {
                // prefer inst_title from row if present
                const titleValue = row[col.joinedColumn] || '';
                if (searchInput) searchInput.value = titleValue;
              } else if (row[col.lookupColumn]) {
                // fallback: set hidden from row and try to set search to joinedColumn
                if (hiddenInput) hiddenInput.value = row[col.lookupColumn];
                const titleValue = row[col.joinedColumn] || '';
                if (searchInput) searchInput.value = titleValue;
              }
            }
          });

          openModal(false);
        }
      }

      function renderNameFunction(row, td) {
        td.textContent = row.alias || '';
        td.style.fontWeight = 'bold';
      }

      function renderPrivilegeFunction(row, td) {
        let privilegeLevel = Number(row.privileges);

        let styleClass = '';
        let displayText = '';
        switch (privilegeLevel) {
          case 0:
          case 1:
            displayText = 'User';
            styleClass = 'userRole';
            break;
          case 2:
            displayText = 'Contributor';
            styleClass = 'contributorRole';
            break;
          case 3:
            displayText = 'Lead';
            styleClass = 'leadRole';
            break;
          case 4:
            displayText = 'Executive';
            styleClass = 'executiveRole';
            break;
          default:
            displayText = 'User';
            styleClass = 'userRole';
        }
        const label = document.createElement("div");
        label.className = styleClass;
        label.textContent = displayText;
        td.appendChild(label);
      }

      function lastActiveRendererFunction(row, td) {
        const lastActive = row.lastActive;
        if (lastActive) {
          const date = new Date(lastActive);
          td.textContent = isNaN(date.getTime()) ? lastActive : date.toLocaleDateString();
        } else {
          td.textContent = 'Never';
        }
      }

      function statusRendererFunction(row, td) {
        const status = row.status;
        td.textContent = status || 'Unknown';
        if (status === 'Active') {
          td.style.color = 'green';
        } else if (status === 'Inactive') {
          td.style.color = 'red';
        } else {
          td.style.color = 'black';
        }
      }

      function submissionStatusRendererFunction(row, td) {
        const statusRaw = (row.status || '').toString();
        const status = statusRaw.trim();
        let styleClass = 'unknownStatus';
        let displayText = status || 'Unknown';

        const lower = status.toLowerCase();
        if (lower === 'approved' || lower === 'approve') {
          styleClass = 'approvedStatus';
          displayText = 'Approved';
        } else if (lower === 'rejected' || lower === 'reject') {
          styleClass = 'rejectedStatus';
          displayText = 'Rejected';
        } else if (lower === 'pending' || lower === 'submitted' || lower === 'awaiting') {
          styleClass = 'pendingStatus';
          displayText = 'Pending';
        } else if (status) {
          displayText = status.charAt(0).toUpperCase() + status.slice(1);
        }

        const label = document.createElement('div');
        label.className = styleClass;
        label.textContent = displayText;
        td.appendChild(label);
      }

      function assignRendererFunction(row, td) {
        const assignedTo = row.assignedTo;
        td.textContent = assignedTo || 'Unassigned';
      }

      function renderNavMenu() {
        const container = document.getElementById('navigationMenu');
        if (!container) {
          return;
        }
        container.innerHTML = '';
        navMenu.forEach(item => {
          const div = document.createElement('div');
          div.className = 'clickable';
          if (item.onClick) {
            div.onclick = () => {
              const handlerFunction = navMenuOnClickHandlers[item.onClick];
              if (handlerFunction && typeof handlerFunction === 'function') {
                handlerFunction();
              }
            };
          } else if (item.tableKey) {
            div.onclick = () => {
              onTableSelected(item.tableKey);
            };
          }
          if (item.icon) {
            const img = document.createElement('img');
            img.className = 'nav-icon';
            img.src = item.icon;
            img.alt = item.label + ' icon';
            div.appendChild(img);
          }
          const text = document.createTextNode(' ' + (item.label || item.tableKey));
          div.appendChild(text);
          container.appendChild(div);
        });
      }

      let currentTable = null;

      function onTableSelected(selectedTable) {
        if (selectedTable) {
          return fetchTableData(selectedTable)
            .then(() => {
              document.getElementById('tableTitle').textContent = tables[selectedTable].displayName;
              currentTable = selectedTable;
            });
        } else {
          clearTable();
          currentTable = null;
        }
      }

      function fetchTableData(tableName) {
        return fetch(`/dataManagement/table-data/${tableName}`)
          .then(response => {
            if (!response.ok) {
              throw new Error('Not authorized or table not found');
            }
            return response.json();
          })
          .then(data => {
            return populateTable(data, tableName);
          })
          .catch(error => {
            console.error('Error fetching data:', error);
            alert('Error: ' + error.message);
          });
      }

      function populateTable(data, tableName) {
        if (!data || !data.length) {
          clearTable();
          return;
        }

        const headerRow = document.getElementById('headerRow');
        const tableBody = document.getElementById('tableBody');

        headerRow.innerHTML = '';
        tableBody.innerHTML = '';

        const columns = tables[tableName].columns;
        columns.forEach(column => {
          if (column.visible) {
            headerRow.innerHTML += `<th data-column="${column.label}">${column.label}</th>`;
          }
        });

        const firstVisibleColumn = columns.find(col => col.visible);
        if (firstVisibleColumn) {
          data.sort((a, b) => {
            const valueA = a[firstVisibleColumn.name];
            const valueB = b[firstVisibleColumn.name];
            if (valueA < valueB) return -1;
            if (valueA > valueB) return 1;
            return 0;
          });
        }

        data.forEach(row => {
          let tr = document.createElement('tr');
          columns.forEach(column => {
            if (column.visible) {
              let td = document.createElement('td');
              populateCell(row, column, td);
              tr.appendChild(td);
            }
          });
          tableBody.appendChild(tr);
        });
        return Promise.resolve();
      }

      function populateCell(row, column, td) {
        if (column.button) {
          const button = document.createElement('button');
          button.textContent = column.label || column.button;
          if (column.onClickFunction && typeof column.onClickFunction === 'string') {
            const clickFunctionName = column.onClickFunction;
            button.onclick = () => clickHandlers[clickFunctionName](row);
          }
          td.appendChild(button);
          return;
        }
        if (column.renderFunction && typeof column.renderFunction === 'string') {
          const renderFunctionName = column.renderFunction;
          renderers[renderFunctionName](row, td);
          return;
        }
        const cellData = row[column.name];
        if (cellData === null || cellData === undefined) {
          td.textContent = '';
        }
        if (typeof cellData === 'object') {
          td.textContent = JSON.stringify(cellData);
        }
        if (column.type === 'date') {
          const date = new Date(cellData);
          td.textContent = isNaN(date.getTime()) ? cellData : date.toLocaleDateString();
        }
        td.textContent = cellData;
      }

      function clearTable() {
        document.getElementById('headerRow').innerHTML = '';
        document.getElementById('tableBody').innerHTML = '';
      }

      function buildModalForReview(row) {
        const modalTitle = document.getElementById('modalTitle');
        modalTitle.textContent = `Review Submission - ${row.operation.charAt(0).toUpperCase() + row.operation.slice(1)}`;
        const fieldsContainer = document.getElementById('modalFields');
        fieldsContainer.innerHTML = '';

        modalMode = 'review';
        currentRow = row;
        console.log(row);

        let dataObj = {};
        if (row && row.data) {
          try {
            dataObj = (typeof row.data === 'string') ? JSON.parse(row.data) : row.data;
          } catch (err) {
            console.warn('Failed to parse row.data:', err);
            dataObj = {data: row.data};
          }
        }

        if (!dataObj || Object.keys(dataObj).length === 0) {
          fieldsContainer.innerHTML = '<div class="form-row">No data fields available</div>';
        } else {
          for (const [key, value] of Object.entries(dataObj)) {
            const labelText = key;
            const rowDiv = document.createElement('div');
            rowDiv.className = 'form-row';

            const label = document.createElement('label');
            label.setAttribute('for', `field_${key}`);
            label.textContent = labelText;
            rowDiv.appendChild(label);

            const input = document.createElement('input');
            input.type = 'text';
            input.id = `${key}`;
            input.name = key;
            input.value = (value === null || value === undefined) ? '' : (typeof value === 'object' ? JSON.stringify(value) : value);
            input.setAttribute('data-col-name', key);
            input.placeholder = `Enter ${labelText}`;
            input.disabled = true; // read-only for review display
            rowDiv.appendChild(input);

            fieldsContainer.appendChild(rowDiv);
          }
        }

        // Add simple review controls (decision + comments)
        const decisionRow = document.createElement('div');
        decisionRow.className = 'form-row';
        const decisionLabel = document.createElement('label');
        decisionLabel.textContent = 'Decision';
        decisionLabel.setAttribute('for', 'reviewDecision');
        decisionRow.appendChild(decisionLabel);
        const decisionSelect = document.createElement('select');
        decisionSelect.id = 'reviewDecision';
        decisionSelect.name = 'reviewDecision';
        ['Approve', 'Reject'].forEach(optionValue => {
          const optionElement = document.createElement('option');
          optionElement.value = optionValue;
          optionElement.text = optionValue;
          decisionSelect.appendChild(optionElement);
        });
        decisionRow.appendChild(decisionSelect);
        fieldsContainer.appendChild(decisionRow);

        const commentsRow = document.createElement('div');
        commentsRow.className = 'form-row';
        const commentsLabel = document.createElement('label');
        commentsLabel.textContent = 'Comments';
        commentsLabel.setAttribute('for', 'reviewComments');
        commentsRow.appendChild(commentsLabel);
        const comments = document.createElement('textarea');
        comments.id = 'reviewComments';
        comments.name = 'reviewComments';
        comments.placeholder = 'Enter review comments (optional)';
        commentsRow.appendChild(comments);
        fieldsContainer.appendChild(commentsRow);
      }

      function buildModalForTable(tableName) {
        const modalTitle = document.getElementById('modalTitle');
        modalTitle.textContent = `Add New Entry to ${tables[tableName]?.displayName || tableName}`;
        const fieldsContainer = document.getElementById('modalFields');
        fieldsContainer.innerHTML = '';

        modalMode = 'add';

        if (!tableName || !tables[tableName]) {
          fieldsContainer.innerHTML = '<div class="form-row">No fields available</div>';
          return;
        }

        const columns = tables[tableName].columns || [];
        const formColumns = columns.filter(c => {
          return c.name !== 'id' && c.name !== undefined;
        });

        if (formColumns.length === 0) {
          fieldsContainer.innerHTML = '<div class="form-row">No editable fields for this table.</div>';
          return;
        }

        formColumns.forEach(col => {
          const labelText = col.label || col.name;
          const row = document.createElement('div');
          row.className = 'form-row';

          // decide input ids first so label can reference the correct input
          let inputId = `field_${col.name}`;
          if (col.crossReferenceTable) {
            inputId = `search_${col.lookupColumn}`; // search input id for crossRef
          }
          const label = document.createElement('label');
          label.setAttribute('for', inputId);
          label.textContent = labelText;
          row.appendChild(label);

          if (col.crossReferenceTable) {
            // create a typeahead input for cross-referenced locations
            const searchInput = document.createElement('input');
            searchInput.type = 'text';
            searchInput.id = `search_${col.lookupColumn}`; // e.g. search_inst_id
            searchInput.placeholder = `Search ${labelText}`;
            searchInput.autocomplete = 'off';

            // hidden input that will store the actual id to submit
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.id = `${col.lookupColumn}`; // e.g. inst_id
            hiddenInput.name = col.lookupColumn;
            hiddenInput.setAttribute('data-col-name', col.lookupColumn);

            const resultsDiv = document.createElement('div');
            resultsDiv.className = 'typeahead-results';
            resultsDiv.id = `results_${col.lookupColumn}`;
            resultsDiv.style.position = 'absolute';
            resultsDiv.style.background = 'white';
            resultsDiv.style.border = '1px solid #ccc';
            resultsDiv.style.zIndex = 10000;
            resultsDiv.style.maxHeight = '200px';
            resultsDiv.style.overflowY = 'auto';
            resultsDiv.style.display = 'none';

            // hook up typing -> search
            let searchTimeout = null;
            searchInput.addEventListener('input', function(e) {
              const v = e.target.value;
              hiddenInput.value = ''; // clear selection when typing
              if (searchTimeout) clearTimeout(searchTimeout);
              if (!v || v.length < 2) {
                resultsDiv.style.display = 'none';
                resultsDiv.innerHTML = '';
                return;
              }
              searchTimeout = setTimeout(() => {
                fetch(`/dataManagement/location-search?query=${encodeURIComponent(v)}`)
                  .then(r => r.json())
                  .then(list => {
                    resultsDiv.innerHTML = '';
                    if (!list || !list.length) {
                      resultsDiv.style.display = 'none';
                      return;
                    }
                    list.forEach(item => {
                      const itemDiv = document.createElement('div');
                      itemDiv.className = 'typeahead-item';
                      itemDiv.style.padding = '6px';
                      itemDiv.style.cursor = 'pointer';
                      itemDiv.textContent = item.inst_title;
                      itemDiv.addEventListener('click', () => {
                        searchInput.value = item.inst_title;
                        hiddenInput.value = item.id;
                        resultsDiv.style.display = 'none';
                      });
                      resultsDiv.appendChild(itemDiv);
                    });
                    resultsDiv.style.display = 'block';
                  }).catch(err => {
                    console.error('Location search failed', err);
                  });
              }, 200);
            });

            row.appendChild(searchInput);
            row.appendChild(hiddenInput);
            row.appendChild(resultsDiv);
          } else {
            const input = document.createElement('input');
            input.type = 'text';
            input.id = `${col.name}`;
            input.name = col.name;
            input.setAttribute('data-col-name', col.name);
            input.placeholder = `Enter ${labelText}`;
            row.appendChild(input);
          }

          fieldsContainer.appendChild(row);
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        renderNavMenu();
        const modalForm = document.getElementById('modalForm');
        if (modalForm) {
          modalForm.addEventListener('submit', (e) => {
            e.preventDefault();

            if (modalMode === 'review') {
              if (!currentRow) {
                alert('No review row specified.');
                return;
              }
              const decision = document.getElementById('reviewDecision')?.value || '';
              const comments = document.getElementById('reviewComments')?.value || '';

              const payload = {
                id: currentRow.id,
                decision: decision,
                comments: comments
              };

              fetch(`/dataManagement/pending-change/review`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(payload)
              }).then(res => {
                if (!res.ok) {
                  throw new Error('Review submit failed');
                }
                return res.json();
              }).then(() => {
                closeModal();
                if (currentTable) {
                  fetchTableData(currentTable);
                }
              }).catch(err => {
                console.error(err);
                alert('Review submit error: ' + err.message);
              });

              return;
            }

            // add or edit mode
            if (modalMode === 'add' || modalMode === 'edit') {
              if (!currentTable) {
                alert('No table selected.');
                return;
              }
              const payload = {
                tableName: currentTable,
                rowKey: modalMode === 'add' ? {} : getRowKey(currentRow),
                operation: modalMode === 'add' ? 'insert' : 'update',
                data: {}
              };
              modalForm.querySelectorAll('[data-col-name]').forEach(inputValue => {
                payload.data[inputValue.dataset.colName] = inputValue.value;
              });

              fetch(`/dataManagement/pending-change`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(payload)
              }).then(res => {
                if (!res.ok) throw new Error('Submit failed');
                return res.json();
              }).then(() => {
                closeModal();
                // refresh table
                fetchTableData(currentTable);
              }).catch(err => {
                console.error(err);
                alert('Submit error: ' + err.message);
              });
            } else {
              alert('Unknown modal mode: ' + modalMode);
            }
          });
        }
      });

      function getRowKey(currentRow) {
        const rowKeyMap = {
          mapButtons: 'part_name',
          locations: 'id',
          documents: 'id',
          participation: 'id',
          users: 'email'
        };

        const key = rowKeyMap[currentTable];
        const value = currentRow[key];
        const result = {[key]: value};
        console.log(result);
        return result;
      }

      function addNewEntry() {
        if (!currentTable) {
          alert('Please select a table first.');
          return;
        }

        buildModalForTable(currentTable);

        openModal();
      }

      function openModal(reset=true) {
        if(reset) {
          document.getElementById('modalForm').reset();
        }
        document.getElementById('modalOverlay').style.display = 'flex';
        setTimeout(() => {
          document.getElementById('modalOverlay').scrollTop = 0;
        }, 0);
      }

      function closeModal() {
        document.getElementById('modalOverlay').style.display = 'none';
      }

      function changePassword() {
        httpPostAsync('/account/resetPassword', passwordChanged);
      }

      function passwordChanged(response) {
        clearFields();
        if (response === "true") {
          showPasswordChangedPopup();
        } else {
          showPasswordChangeFailedPopup();
        }
      }

      function showPasswordChangedPopup() {
        window.alert("Password changed")
      }

      function showPasswordChangeFailedPopup() {
        window.alert("Password changed failed")
      }

      function showForgotPasswordPopup() {
        window.alert("You can start the password recovery process by emailing us at ubhub.org@gmail.com Please include the email associated with your account, your username, full name, and address in the message.");
      }

      function clearFields() {
        document.getElementById('oldPassword').value = "";
        document.getElementById('newPassword').value = "";
        document.getElementById('confirmNewPassword').value = "";
      }

      function httpPostAsync(theUrl, callback) {
        let oldPassword = document.getElementById('oldPassword').value;
        let newPassword = document.getElementById('newPassword').value;
        let confirmNewPassword = document.getElementById('confirmNewPassword').value;
        if (newPassword !== confirmNewPassword) {
          window.alert("New password must match confirm password");
          return;
        }
        let data = {
          "oldPassword": oldPassword,
          "newPassword": newPassword
        }
        var xmlHttp = new XMLHttpRequest();
        xmlHttp.onreadystatechange = function () {
          if (xmlHttp.readyState == 4 && xmlHttp.status == 200)
            callback(xmlHttp.responseText);
        }
        xmlHttp.open("POST", theUrl, true); // true for asynchronous
        xmlHttp.setRequestHeader("Content-Type", "application/json; charset=utf-8");
        var dataAsJson = JSON.stringify(data);
        xmlHttp.send(dataAsJson);
      }

    link(rel='stylesheet', href='/stylesheets/style.css')
    link(rel='stylesheet', href='/stylesheets/index.css')
    style.
        :root {
            --contributor-color: #3f7a5e;
            --contributor-hover-color: #3f7a5e;
            --contributor-background-color: #dfe6e1;
            --lead-color: #dc7824;
            --lead-hover-color: #dc7824;
            --lead-background-color: #f4e7db;
            --executive-color: #204161;
            --executive-hover-color: #204161;
            --executive-background-color: #dae8f5;

            --approved-color: #1f7a3a;
            --approved-hover-color: #1f7a3a;
            --approved-background-color: #e6f4ea;
            --rejected-color: #a61a1a;
            --rejected-hover-color: #a61a1a;
            --rejected-background-color: #fdecea;
            --pending-color: #b36b00;
            --pending-hover-color: #b36b00;
            --pending-background-color: #fff3d6;
            --unknown-background-color: #e2e2e2;
        }



        .horizontalFlex {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            margin-right: 20px;
        }

        .layout {
            display: flex;
            gap: 20px;
            align-items: flex-start;
        }

        .left-col {
            flex: 0 0 180px; /* fixed sidebar width */
            border-right: 1px solid #e5e5e5;
            background: #fff;
            height: 100vh;
            position: sticky;
            top: 60px;
            overflow-y: auto;
        }

        .main-col {
            flex: 1; /* take remaining space */
            min-width: 0; /* prevents overflow with long content */
        }

        .clickable {
            cursor: pointer;
            padding: 10px;
        }

        .clickable:hover {
            background-color: #f3f7fb;
            transform: translateY(-1px);
        }

        .nav-icon {
            width: 18px;
            height: 18px;
            margin-right: 8px;
            vertical-align: middle;
        }

        /* Modern table styles: no vertical dividers, white header, dark grey headings, subtle hover lift */
        .data-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-top: 20px;
            background: transparent;
            border-radius: 10px;
            /*overflow: hidden; -- must not be set to have sticky header*/
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
            cursor: default;
        }

        .data-table th,
        .data-table td {
            padding: 12px 16px;
            text-align: left;
            vertical-align: middle;
            border: none; /* remove vertical dividers */
        }

        /* Header: white background, dark grey text, subtle bottom divider, sticky */
        .data-table thead th {
            position: sticky;
            top: 0;
            background-color: #ffffff;
            color: #2f3438;
            font-weight: 600;
            font-size: 13px;
            letter-spacing: 0.2px;
            border-bottom: 1px solid rgba(31, 41, 55, 0.06);
            z-index: 2;
        }

        /* Horizontal separators only between rows */
        .data-table tbody tr + tr td {
            border-top: 1px solid #f1f3f5;
        }

        /* Subtle alternating tint (very light) */
        .data-table tbody tr:nth-child(even) td {
            background-color: rgba(15, 23, 42, 0.01);
        }

        /* Hover effect for body rows (not header) */
        .data-table tbody tr {
            transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
            background-clip: padding-box;
        }

        .data-table tbody tr:hover {
            transform: translateY(-4px);
            background: linear-gradient(90deg, rgba(245, 250, 255, 0.9), rgba(255, 255, 255, 0.98));
            box-shadow: 0 12px 30px rgba(31, 41, 55, 0.06);
        }

        /* Status label styles */
        .baseStatus,
        .approvedStatus,
        .rejectedStatus,
        .pendingStatus
        {
            border-radius: 4px;
            font-weight: 600;
            font-size: 12px;
            display: inline-block;
            text-align: center;
            padding: 2px 4px;
            cursor: default;
        }

        .approvedStatus {
          background: var(--approved-background-color);
          color: var(--approved-color);
          border-color: var(--approved-color);
        }

        .approvedStatus:hover {
          background: var(--approved-hover-color);
          color: white;
        }

        .rejectedStatus {
          background: var(--rejected-background-color);
          color: var(--rejected-color);
          border-color: var(--rejected-color);
        }

        .rejectedStatus:hover {
          background: var(--rejected-hover-color);
          color: white;
        }

        .pendingStatus {
          background: var(--pending-background-color);
          color: var(--pending-color);
          border-color: var(--pending-color);
        }

        .pendingStatus:hover {
          background: var(--pending-hover-color);
          color: white;
        }

        .baseRole,
        .userRole,
        .contributorRole,
        .leadRole,
        .executiveRole {
            border-radius: 4px;
            font-weight: 600;
            font-size: 12px;
            display: inline-block;
            text-align: center;
            padding: 2px 4px;
            cursor: default;
        }

        .userRole {
          background: #e2e2e2;
          color: black;
          border-color: black;
        }

        .contributorRole {
          background: var(--contributor-background-color);
          color: var(--contributor-color);
          border-color: var(--contributor-color);
        }

        .contributorRole:hover {
          background: var(--contributor-hover-color);
          color: white;
        }

        .leadRole {
          background: var(--lead-background-color);
          color: var(--lead-color);
          border-color: var(--lead-color);
        }

        .leadRole:hover {
          background: var(--lead-hover-color);
          color: white;
        }

        .executiveRole {
          background: var(--executive-background-color);
          color: var(--executive-color);
          border-color: var(--executive-color);
        }

        .executiveRole:hover {
          background: var(--executive-hover-color);
          color: white;
        }

        /* Prevent header from getting hover transform */
        .data-table thead tr:hover {
            transform: none;
            box-shadow: none;
            background: none;
        }

        .table-container {
            max-height: 70vh;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .modal {
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            overflow-y: scroll;
            height: 80vh;
        }

        .modal-title {
            margin: 0 0 12px 0;
            font-size: 18px;
        }

        .form-row {
            margin-bottom: 10px;
            display: flex;
            flex-direction: column;
        }

        .form-row input {
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .modal-actions {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            margin-top: 12px;
        }


  body
  div(style="padding-top:40px;")

  div.layout
    aside.left-col
      nav
        div#navigationMenu

    main.main-col
      div.container
        div.horizontalFlex
          h1#tableTitle
          if user
            span#userAlias(style="margin-left:12px; font-size:14px; color:#555") Hello, #{user}
          button.primary#addButton(onclick="addNewEntry()") Add New Entry

        div
          div
            div.table-container
              table.data-table#dataTable
                thead
                  tr#headerRow
                tbody#tableBody

// Modal overlay for adding a new entry
.modal-overlay(id="modalOverlay", style="display:none;")
  .modal(id="modalContainer")
    h2.modal-title#modalTitle
    form#modalForm
      #modalFields
      .modal-actions
        button(type="button", onclick="closeModal()") Cancel
        button(type="submit") Submit

.modal-overlay(id="modalOverlayMyProfile", style="display:none;")
  .modal(id="modalContainerMyProfile")
    div
      div(style="margin: 50px 0px 50px 0px;") #{username}
      div
        div(style="margin-bottom:10px;") <b>Account details</b>
        div
        div(style="margin-bottom:10px;") <b>Change password</b>
        div Current password
        input(type="password" id="oldPassword" style="border-radius:4px; border-style:solid; border-width:1px;")
        div(style="color:blue; font-size:10px; cursor:pointer; margin-bottom:10px;" onclick="showForgotPasswordPopup()") Forgot password
        div New password
        input(type="password" id="newPassword" style="border-radius:4px; border-style:solid; border-width:1px; margin-bottom:10px;")
        div Confirm new password
        input(type="password" id="confirmNewPassword" style="border-radius:4px; border-style:solid; border-width:1px;")
        div
          button(onclick="changePassword()" style="margin-top:10px; margin-bottom:10px;") Change password
    div(style="margin-bottom:200px;")
      button(onclick="closeMyProfileModalFunction()" style="margin:auto;") Close
