FROM node:18-bullseye-slim

# Create app directory
WORKDIR /usr/src/app

# Install build deps for any native modules (optional)
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*

# Copy package manifests first for layer caching
COPY package.json package-lock.json* ./

# Use npm install (with legacy-peer-deps) to avoid failing on mismatched/absent lockfiles in CI
RUN npm install --legacy-peer-deps --no-audit --no-fund --silent

# Copy the rest of the application source
COPY . ./

# Default command runs tests; using npm ensures test script from package.json is used
CMD ["npm", "test"]
